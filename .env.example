# Leave empty to call the API same-origin (the Vite dev proxy in development, nginx in the
# container). The backend has no CORS configuration, deliberately - do not point this at a
# different origin.
VITE_API_BASE_URL=

# Dev-only: where the Vite dev-server proxy forwards /api, /tasks, /v3/api-docs, /swagger-ui.
VITE_DEV_PROXY_TARGET=http://localhost:8080
